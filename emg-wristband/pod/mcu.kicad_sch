	(text "R20: series resistor at the source of the SPI clock, which fans out to both converters.\nThe value is a starting point, not from a datasheet (see OPEN.md)."
		(exclude_from_sim no)
		(at 25.4 141 0)
		(effects (font (size 1.1 1.1)) (justify left top))
		(uuid "d43486f9-19b2-502e-8c92-e298c9850d1b")
	)
	(text "Pin choice: Nordic's nRF52840 specification v1.5 marks every XIAO pin except D4 (P0.04) and\nD5 (P0.05) as low-frequency I/O (up to 10 kHz), because they sit next to the radio.\nThe two fast SPI lines, SCLK and MISO, therefore use D5 and D4. MOSI only carries commands.\nFirmware: drive P0.13 low for the 100 mA charge current (Seeed schematic, R12 and R18)."
		(exclude_from_sim no)
		(at 25.4 151 0)
		(effects (font (size 1.1 1.1)) (justify left top))
		(uuid "ca9435d0-be35-5397-8074-c4bfae8ccf67")
	)
