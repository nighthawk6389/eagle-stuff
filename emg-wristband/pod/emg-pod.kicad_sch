	(text "EMG wristband: main pod, rev A"
		(exclude_from_sim no)
		(at 25.4 30 0)
		(effects (font (size 3 3) (bold yes)) (justify left bottom))
		(uuid "224e7add-31cf-52ee-a89a-eae352b289e9")
	)
	(text "16 differential EMG channels at 2 kSPS: two ADS1298 converters, a Seeed XIAO nRF52840 Sense,\na 3.0 V analog rail that hardware switches off whenever USB is plugged in, and a vibration motor.\nThese files are generated by gen/build.py. Change the generator, not the files."
		(exclude_from_sim no)
		(at 25.4 36 0)
		(effects (font (size 1.3 1.3)) (justify left top))
		(uuid "3bb64cc5-ecf9-5d3c-98a1-22e506f08593")
	)
	(text "Rails\n  VBAT   battery node = XIAO BAT+ pad (charger output), 3.0 to 4.2 V\n  +3V3   XIAO regulator output; converter digital supply (DVDD)\n  AVDD   3.0 V from U2, converter analog supply; off while USB is present\n\nXIAO pins\n  D0  CS_A        D6   ADS_START\n  D1  CS_B        D7   ADS_RESET\n  D2  DRDY_A      D8   AFE_EN\n  D3  DRDY_B      D9   MOTOR\n  D4  MISO        D10  MOSI\n  D5  SCLK\n\nOpen questions are in OPEN.md."
		(exclude_from_sim no)
		(at 160 60.96 0)
		(effects (font (size 1.3 1.3)) (justify left top))
		(uuid "e3fdd13d-1bc1-51c3-be90-7744b041e643")
	)
